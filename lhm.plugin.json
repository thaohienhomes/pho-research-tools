    {
      "name": "prisma_flow_diagram",
      "title": "PRISMA 2020 flow diagram",
      "description": "Draw a PRISMA 2020 flow diagram for a new systematic review from the record counts, as a PNG image plus an SVG and download links. Give the counts you have; boxes that follow arithmetically from others are filled in and marked as derived. The tool checks that the numbers add up (records identified minus removed equals screened, and so on) and returns a warning naming each box that does not, with the value it should have. The diagram always shows the numbers exactly as given. Add `otherMethods` counts to draw the second column (websites, organisations, citation searching).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "counts": {
            "type": "object",
            "properties": {
              "databases": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000,
                "description": "Records identified from databases (total)."
              },
              "databaseSources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "n": {
                      "$ref": "#/properties/counts/properties/databases"
                    }
                  },
                  "required": [
                    "name",
                    "n"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30,
                "description": "Per-database counts, e.g. [{\"name\":\"MEDLINE\",\"n\":812}]."
              },
              "registers": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Records identified from registers."
              },
              "registerSources": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/counts/properties/databaseSources/items"
                },
                "maxItems": 30
              },
              "duplicatesRemoved": {
                "$ref": "#/properties/counts/properties/databases"
              },
              "automationIneligible": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Records marked ineligible by automation tools."
              },
              "otherRemoved": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Records removed for other reasons before screening."
              },
              "recordsScreened": {
                "$ref": "#/properties/counts/properties/databases"
              },
              "recordsExcluded": {
                "$ref": "#/properties/counts/properties/databases"
              },
              "reportsSought": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Reports sought for retrieval."
              },
              "reportsNotRetrieved": {
                "$ref": "#/properties/counts/properties/databases"
              },
              "reportsAssessed": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Reports assessed for eligibility."
              },
              "reportsExcludedReasons": {
                "type": "array",
                "items": {
                  "$ref": "#/properties/counts/properties/databaseSources/items"
                },
                "maxItems": 30,
                "description": "Reports excluded, one entry per reason."
              },
              "reportsExcluded": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Total reports excluded, when reasons are not itemised."
              },
              "studiesIncluded": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Studies included in the review."
              },
              "reportsIncluded": {
                "$ref": "#/properties/counts/properties/databases",
                "description": "Reports of included studies."
              },
              "otherMethods": {
                "type": "object",
                "properties": {
                  "websites": {
                    "$ref": "#/properties/counts/properties/databases"
                  },
                  "organisations": {
                    "$ref": "#/properties/counts/properties/databases"
                  },
                  "citationSearching": {
                    "$ref": "#/properties/counts/properties/databases"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "$ref": "#/properties/counts/properties/databaseSources/items"
                    },
                    "maxItems": 30
                  },
                  "reportsSought": {
                    "$ref": "#/properties/counts/properties/databases"
                  },
                  "reportsNotRetrieved": {
                    "$ref": "#/properties/counts/properties/databases"
                  },
                  "reportsAssessed": {
                    "$ref": "#/properties/counts/properties/databases"
                  },
                  "reportsExcludedReasons": {
                    "type": "array",
                    "items": {
                      "$ref": "#/properties/counts/properties/databaseSources/items"
                    },
                    "maxItems": 30
                  },
                  "reportsExcluded": {
                    "$ref": "#/properties/counts/properties/databases"
                  }
