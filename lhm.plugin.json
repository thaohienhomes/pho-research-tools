    {
      "name": "search_papers",
      "title": "Search papers",
      "description": "Search PubMed and OpenAlex for real papers. Every result carries a DOI or PubMed ID that resolves, so nothing returned can be fabricated. Finds sources for a claim or a topic. Filters: publication year range, open-access only, study types, and the number of results. Retracted papers are left out by default. Preprints are included and marked `preprint: true` (not peer reviewed). Results are ranked by the databases' relevance, alternating between the two sources.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "description": "What to look for, in English keywords (e.g. \"sepsis early antibiotics mortality\")."
          },
          "year_from": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2100,
            "description": "Earliest publication year, inclusive."
          },
          "year_to": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2100,
            "description": "Latest publication year, inclusive."
          },
          "open_access_only": {
            "type": "boolean",
            "default": false,
            "description": "Only papers with a free, legal full text."
          },
          "study_types": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            },
            "maxItems": 5,
            "description": "Study designs. Known ids use database filters: rct, clinical-trial, systematic-review, meta-analysis, review, guideline, cohort, case-control, case-report, observational. Any other text is added as keywords."
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10,
            "description": "Number of results, 1–50."
          },
          "include_retracted": {
            "type": "boolean",
            "default": false,
            "description": "Keep retracted papers (flagged) instead of leaving them out."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rank": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "authors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "year": {
                  "type": "integer"
                },
                "journal": {
                  "type": "string"
                },
                "doi": {
                  "type": "string"
                },
                "pmid": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "links": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                },
                "open_access": {
                  "type": "object",
                  "properties": {
                    "is_oa": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "is_oa"
                  ],
                  "additionalProperties": false
                },
                "found_in": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "study_type_match": {
                  "type": "string"
                },
                "retracted": {
                  "type": "boolean"
                },
                "preprint": {
                  "type": "boolean"
                },
                "cited_by_count": {
                  "type": "integer"
                }
              },
              "required": [
                "rank",
                "title",
                "authors",
                "url",
                "links",
                "open_access",
                "found_in",
                "retracted",
                "preprint"
              ],
              "additionalProperties": false
            }
          },
          "excluded": {
            "type": "object",
