    {
      "name": "format_citations",
      "title": "Format citations",
      "description": "Format references in a citation style (APA 7, MLA 9, Chicago author-date, Harvard, Vancouver, IEEE, AMA) or export them as BibTeX, RIS or CSL-JSON. By default every reference is first verified against Crossref, PubMed and OpenAlex, and verified references are formatted from the database record, so wrong years, pages or author names in the input are corrected. References that could not be verified are formatted exactly as written and flagged in `entries[].warnings`. Returns the bibliography and, for text and html output, the matching in-text citation for each reference.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "references": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000,
            "description": "References in any form: a pasted list in any style, BibTeX, RIS, CSL-JSON, or DOIs one per line."
          },
          "style": {
            "type": "string",
            "enum": [
              "apa",
              "mla",
              "chicago",
              "harvard",
              "vancouver",
              "ieee",
              "ama"
            ],
            "default": "apa",
            "description": "Citation style: apa (APA 7), mla (MLA 9), chicago (Chicago author-date), harvard (Harvard), vancouver (Vancouver), ieee (IEEE), ama (AMA). Ignored for bibtex/ris/csl-json output."
          },
          "output": {
            "type": "string",
            "enum": [
              "text",
              "html",
              "bibtex",
              "ris",
              "csl-json"
            ],
            "default": "text",
            "description": "text (plain bibliography), html, bibtex, ris or csl-json."
          },
          "verify": {
            "type": "boolean",
            "default": true,
            "description": "Verify each reference before formatting (recommended). When false, references are formatted exactly as given, without corrections."
          }
        },
        "required": [
          "references"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "style": {
            "type": "string"
          },
          "style_title": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer"
                },
                "verified": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string"
                },
                "retracted": {
                  "type": "boolean"
                },
                "bibliography": {
                  "type": "string"
                },
                "in_text": {
                  "type": "string"
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "index",
                "verified",
                "retracted",
                "bibliography",
                "in_text",
                "warnings"
              ],
              "additionalProperties": false
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quota": {
            "type": "object",
            "properties": {
              "plan": {
                "type": "string",
                "enum": [
                  "anon",
                  "free"
                ]
              },
              "metric": {
                "type": "string",
                "enum": [
                  "verifications",
                  "calls"
                ]
              },
              "used": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "resets": {
                "type": "string"
              }
            },
            "required": [
              "plan",
              "metric",
              "used",
              "limit",
              "resets"
            ],
            "additionalProperties": false
          }
        },
        "required": [
