{
  "name": "@pho/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ph\u1edf Research Tools: remote MCP server (Streamable HTTP) over @pho/scholar-core.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx --env-file-if-exists=.env.local src/main.ts",
    "build": "node scripts/build-vercel.mjs && node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.15",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@neondatabase/serverless": "^0.10.4",
    "@pho/scholar-core": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.13.5",
    "tsx": "^4.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
