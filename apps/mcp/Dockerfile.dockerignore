# Build context for apps/mcp/Dockerfile (BuildKit reads <Dockerfile>.dockerignore
# next to the Dockerfile, so this does not affect any other image).
# The context is the repository root; send only what the Dockerfile copies.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!tsconfig.json
!packages/citation-engine
!packages/scholar-core
!apps/mcp
**/node_modules
**/dist
apps/mcp/assets
**/.env*
!**/.env.example
