# Phở Research Tools MCP server. Every variable is optional for a local run.
# Copy to .env.local (gitignored) and fill in; `pnpm start` and `pnpm dev` load it.
# On Vercel, set them as project environment variables. Never commit real values.

# Port for `pnpm start` (ignored on Vercel).
PORT=8787

# Public origin used in the links this server hands out (MCP endpoint, PRISMA
# images), e.g. https://tools.pho.chat. Set it on every deployment.
PUBLIC_URL=

# Neon Postgres for quotas (rt_usage) and the response cache (rt_cache).
# Unset = in-memory, which is fine for one process but resets on restart.
# Use a development database, not production.
DATABASE_URL=

# Sent to Crossref / OpenAlex / NCBI as the polite-pool contact address.
SCHOLAR_CONTACT_EMAIL=

# Optional API keys raise upstream rate limits.
PUBMED_API_KEY=
OPENALEX_API_KEY=

# PostHog server-side events (rt_tool_call). Unset = no analytics.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Secret salt for hashing the caller's IP into the quota subject. REQUIRED when
# deployed (VERCEL=1 or NODE_ENV=production): the server refuses to start
# without it, and rejects anything under 32 characters. Generate with
# `openssl rand -hex 32`; keep it stable, since
# changing it resets every allowance. Unset locally = random per process.
QUOTA_SALT=

# Daily anonymous allowances.
QUOTA_ANON_VERIFICATIONS_PER_DAY=30
QUOTA_ANON_CALLS_PER_DAY=200

# Optional sign-in with a Phở account: the Clerk instance that issues tokens,
# e.g. https://clerk.pho.chat. Unset = no /mcp/login, everyone is anonymous.
# Clerk must have CIMD or dynamic client registration turned on (see README).
OAUTH_ISSUER=

# Monthly allowances for a signed-in account.
QUOTA_USER_VERIFICATIONS_PER_MONTH=300
QUOTA_USER_CALLS_PER_MONTH=3000

# Shown when an allowance runs out.
UPGRADE_URL=https://pho.chat/pricing

# Trust X-Forwarded-For. Defaults to on when VERCEL=1, off elsewhere. Turn on
# only behind a proxy that overwrites the header.
TRUST_PROXY=
