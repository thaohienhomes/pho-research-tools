{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @pho/mcp...",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "{dist,assets/fonts}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
